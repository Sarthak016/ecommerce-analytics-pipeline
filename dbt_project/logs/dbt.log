[0m10:18:18.494906 [debug] [Thread-3  ]: On model.ecommerce_analytics.mart_revenue_by_category: /* {"app": "dbt", "dbt_version": "1.7.0", "profile_name": "ecommerce_analytics", "target_name": "dev", "node_id": "model.ecommerce_analytics.mart_revenue_by_category"} */

  
    

  create  table "airflow"."analytics_analytics"."mart_revenue_by_category__dbt_tmp"
  
  
    as
  
  (
    -- Mart: Revenue by Product Category
-- Joins orders with products to analyze revenue by category

with orders as (
    select * from "airflow"."analytics_staging"."stg_orders"
),

products as (
    select * from "airflow"."analytics_staging"."stg_products"
),

category_revenue as (
    select
        p.category,
        p.brand,
        count(distinct o.order_id)           as total_orders,
        sum(o.quantity)                      as total_units_sold,
        sum(o.total_amount)                  as total_revenue,
        avg(o.total_amount)                  as avg_order_value,
        sum(o.quantity * p.cost_price)       as total_cost,
        sum(o.total_amount) -
            sum(o.quantity * p.cost_price)   as total_profit,
        avg(p.profit_margin_pct)             as avg_profit_margin
    from orders o
    left join products p on o.product_id = p.product_id
    where o.status = 'completed'
    group by p.category, p.brand
)

select * from category_revenue
  );
  
